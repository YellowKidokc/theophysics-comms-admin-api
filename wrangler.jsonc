/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "theophysics-comms-admin-api",
	"main": "src/index.ts",
	"compatibility_date": "2025-03-03",
    "d1_databases": [
        {
          "binding": "DB",
          "database_name": "theophysics-comms",
          "database_id": "9ee117a7-f92a-4232-bb45-ae124bc57fe8"
        }
    ],
    "secrets_store_secrets": [
        {
            "store_id": "bf04aac0d5954527a69fefc7634cdc4e",
            "binding": "SECRET",
            "secret_name": "cloudflaretokenapi"
        }
    ],
	"observability": {
		"enabled": true
	}
}
